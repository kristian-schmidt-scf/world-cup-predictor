# Required for the Ticker tab — live WC scores (football-data.org free tier).
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# Required for Ticker goal scorers + assists (api-football.com free tier, 100 req/day).
# Register at https://dashboard.api-football.com/register
API_FOOTBALL_KEY=your_key_here

# Optional: override the football-data.org competition code (default: WC)
# FOOTBALL_DATA_COMP=WC
